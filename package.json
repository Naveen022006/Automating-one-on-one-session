{
  "name": "session-automation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:hmr": "tsx scripts/dev.ts --hmr",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts && node scripts/spa-postbuild.mjs",
    "build": "npm run build:web && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:features": "tsx prisma/seed-features.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "dev:logins": "tsx scripts/dev-logins.ts",
    "dev:mock": "tsx scripts/dev-mock.ts",
    "mock:providers": "tsx scripts/mock-providers/index.ts",
    "keys:rotate": "tsx scripts/rotate-encryption-key.ts",
    "keys:verify": "tsx scripts/verify-encryption-keys.ts",
    "expire-holds": "tsx worker/index.ts",
    "worker": "tsx worker/index.ts",
    "test": "node scripts/check-node.mjs && tsx --test --experimental-test-module-mocks tests/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "data:cleanup-test": "tsx scripts/cleanup-test-data.ts",
    "data:normalise-timezones": "tsx scripts/normalise-timezones.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "bullmq": "^6.3.15",
    "dotenv": "^18.0.8",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.15",
    "luxon": "^3.7.2",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "uqr": "0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prisma": "^7.10.1",
    "react-router": "7.18.4",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "mysql2": "^3.24.5",
    "deepmerge-ts": "^8.0.2"
  }
}
