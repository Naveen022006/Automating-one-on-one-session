DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sessions
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Database connection pool (per process). Keep low on hosted poolers (Supabase/PgBouncer cap connections).
DATABASE_POOL_MAX=10
# Cancel any single SQL statement after this long, and fail fast when no pooled connection is free.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Rate limiting (Phase 7). Every /api route is limited (see lib/rate-limit/policies.ts).
# Store: auto (Redis, falling back to Postgres when Redis is down) | redis | postgres | memory
RATE_LIMIT_STORE=auto
# Set to false to disable limits (load tests only). RATE_LIMIT_MULTIPLIER scales every limit (e.g. 2 = double).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1
# The ONE header your platform sets with the real client IP: "cf-connecting-ip" behind Cloudflare, "x-real-ip"
# on Vercel. Unset = right-most X-Forwarded-For entry (appended by your proxy). Never a client-settable header.
CLIENT_IP_HEADER=

# Branding (open decision for the owner; shown in emails, pages and the OG image)
NEXT_PUBLIC_BRAND_NAME=Session Automation
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Locale for formatting money and times in emails/messages
APP_LOCALE=en-IN

# The React front end (web/, doc/12-front-end.md) is built by Vite and served by Next on the same port. In production its HTML
# shell (web/dist/index.html, written by `npm run build`) must exist or the web process refuses to start; so does a standalone
# server with HOSTNAME=127.0.0.1 or ::1 (Next.js would turn the internal rewrite into an external request): use 0.0.0.0 or localhost.
# (The old SPA_GROUPS switch is gone: the app is always the React app. A leftover SPA_GROUPS is ignored with a warning.)
# Only for `npm run dev:hmr` (Vite's dev server on port 5173 in front of `next dev`): where Vite proxies /api and the metadata
# routes. Default http://localhost:3000. That command also sets APP_URL=http://localhost:5173 for the Next process, because the browser
# origin there is the Vite port. `npm run dev` needs neither: it serves everything from port 3000.
SPA_API_TARGET=
# NEXT_PUBLIC_BRAND_NAME, NEXT_PUBLIC_SUPPORT_EMAIL, APP_LOCALE and ENABLE_DESIGN_PAGE are also inputs of the browser
# bundle: Vite reads exactly these four names (nothing else, so no secret can reach the browser) when `npm run build:web`
# runs. Changing one needs a rebuild, not just a restart.

# Razorpay (test keys first). Webhook URL: <APP_URL>/api/webhooks/payment
# Subscribe to: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Chosen by you; must equal the secret typed in the Razorpay dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# true = refund eligible customer/host cancellations straight away; false = flag them for a manual refund.
AUTO_REFUND_ON_CANCEL=false

# Google Calendar / Meet (Phase 3)
# Whose Google OAuth client connects an influencer's calendar (doc/15-influencer-google-credentials.md):
#   own       (default, also when empty) every influencer creates their OWN Google Cloud client and pastes its Client ID and
#             Secret on their Settings page. Nothing below is needed.
#   platform  the shared client below only
#   either    the influencer's own client when they saved one, else the shared one below
GOOGLE_CLIENT_MODE=
# The shared client: only for GOOGLE_CLIENT_MODE=platform or either (grants made earlier with it keep using it).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Every influencer adds this one callback URL to their own client. Empty means <APP_URL>/api/google/callback.
GOOGLE_REDIRECT_URI=
# 32 random bytes, base64. Encrypts influencer refresh tokens, payout details and WhatsApp tokens at rest:
#   openssl rand -base64 32
# LOSING THIS KEY LOSES THOSE VALUES FOR GOOD: keep a copy in your secret manager (doc/08-deployment.md).
TOKEN_ENCRYPTION_KEY=
# Key rotation only (doc/08-deployment.md). Leave empty in normal operation. During a rotation set
# TOKEN_ENCRYPTION_KEY to the NEW key and this to the OLD key, on web, worker and the key tools alike: values not yet
# re-encrypted stay readable (new values are always written with TOKEN_ENCRYPTION_KEY), and `npm run keys:rotate` /
# `npm run keys:verify` read exactly these two variables. Remove it once keys:verify passes.
TOKEN_ENCRYPTION_KEY_PREVIOUS=
# Signs self-service links and OAuth state. 32+ characters are REQUIRED in production (16 is the absolute minimum
# anywhere):  openssl rand -base64 32
# To rotate it, move the old value to APP_SECRET_PREVIOUS (it only verifies links already sent) and remove that 30 days
# later; changing APP_SECRET without it invalidates every link already emailed (doc/08-deployment.md section 9).
APP_SECRET=
APP_SECRET_PREVIOUS=

# WhatsApp Cloud API (Phase 4). Templates: see lib/message-templates.ts for exact names and variables.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret used to verify the X-Hub-Signature-256 header on delivery-status callbacks. It is the same secret as
# META_APP_SECRET below: set either one and both uses (webhook signature, Embedded Signup and the token check) work.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Meta Graph API version for every WhatsApp call (and the Facebook SDK in the sign-up window). Meta retires old versions on a
# schedule: https://developers.facebook.com/docs/graph-api/changelog/versions . Leave empty for the version the app ships with.
WHATSAPP_GRAPH_VERSION=
# true = always fail WhatsApp so the SMS fallback is used (to test the fallback). Development only: refused in production.
WHATSAPP_DISABLED=false
# true = log WhatsApp/SMS instead of sending (local development without provider accounts).
MESSAGING_DRY_RUN=false

# SMS fallback: msg91 | twilio | generic
SMS_PROVIDER=msg91
# MSG91 authkey (or the Bearer key for SMS_PROVIDER=generic)
SMS_API_KEY=
# MSG91 DLT-approved flow ids, one per message type (falls back to MSG91_TEMPLATE_DEFAULT)
MSG91_TEMPLATE_DEFAULT=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_REMINDER_24H=
MSG91_TEMPLATE_REMINDER_15M=
MSG91_TEMPLATE_RESCHEDULE=
MSG91_TEMPLATE_CANCELLATION=
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Only for SMS_PROVIDER=generic
SMS_API_URL=

# Email: resend | postmark | none | log
#   none = the platform sends NO e-mail (allowed in production, one start-up warning): account e-mails are not delivered, so an
#          administrator verifies accounts and hands over password-reset links, and customer e-mail goes only through the
#          influencer's own connected Gmail (doc/15-influencer-google-credentials.md)
#   log  = print to the console; development only, refused in production
EMAIL_PROVIDER=log
EMAIL_FROM="Bookings <bookings@example.com>"
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Error notifications: POST every reported error here (Slack/Discord-compatible "text" field). Optional.
ERROR_WEBHOOK_URL=
# Show the /design component catalogue in production builds (it is always on in development).
ENABLE_DESIGN_PAGE=false

# Payouts (admin pays influencers manually after reconciling payments)
# Days after a session ends before its money becomes payable.
PAYOUT_HOLD_DAYS=2
# Default platform fee in basis points (1000 = 10%). An admin can override it per influencer. 0 = no fee.
PLATFORM_FEE_BPS=0
# Four-eyes payout approval: a second administrator (not the one who created the payout) must approve a payout before it
# can be marked as paid. Default: true in production, false otherwise. With only one administrator, either create a second
# (npm run admin:create) or set this to false.
PAYOUT_FOUR_EYES=
# Only require that approval when the payout's net amount PLUS the same influencer's other unapproved payouts of the last
# 24 hours (same currency) reaches this. In the minor units of each payout's own currency (paise for INR, cents for USD;
# no conversion), so splitting a transfer into small payouts does not avoid approval. 0 = always.
PAYOUT_FOUR_EYES_MIN_MINOR=0

# Administrator two-factor sign-in (TOTP authenticator app). When true, every administrator must enrol under
# Admin > Security before using the console, and sensitive actions need a session that passed the second step.
# Default: true in production, false otherwise. Lost authenticator and recovery codes: npm run admin:create -- --email <admin> --reset-2fa
ADMIN_REQUIRE_2FA=

# Most "find my bookings" e-mails (the /bookings page) the whole platform sends per hour, whoever asks: a guard against mail-bombing.
# Leave this line commented out for the default of 300. 0 = send none. Do NOT leave it set but empty: an empty value is read as 0.
# Over the cap the form answers as usual and sends nothing.
# CUSTOMER_PORTAL_MAIL_CAP_PER_HOUR=300

# Ask influencers to allow sending customer email from their own Gmail (gmail.send is a Google restricted scope;
# set false to request Calendar only, for example before the Google app is verified).
GOOGLE_REQUEST_GMAIL_SEND=true

# WhatsApp: each influencer connects their own WhatsApp Business number (Settings > WhatsApp).
# Meta Embedded Signup (needs your Meta app to be an approved Tech Provider). Leave empty to offer manual connect only.
# META_APP_ID + the app secret (META_APP_SECRET or WHATSAPP_APP_SECRET, the same value) also let us check a pasted access
# token's permissions and expiry with Meta when an influencer connects by hand; without them that check is skipped.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
# Development only: a fixed 6-digit two-step PIN to register Embedded Signup numbers with. Ignored in production, where every
# number is registered with its own random PIN (stored encrypted), because one shared PIN would become every influencer's
# two-step PIN. An influencer whose number already has a PIN types it into the connect form.
WHATSAPP_REGISTRATION_PIN=
# true = for testing only: use the platform number (WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID) when an influencer has not
# connected their own. Default false: without a connection the message goes by SMS.
WHATSAPP_PLATFORM_FALLBACK=false

# Go-live readiness: connections an influencer must have before their page takes bookings. Basics (verified email,
# a service, weekly hours) are always required. Comma list of: google, gmail, whatsapp, payout, approval.
# `approval`: a new page goes live only after an administrator approves it (Admin > Influencers). While the gate is off, a
# page that finishes onboarding is approved automatically (and an administrator can approve pages in advance), so turning
# the gate on later never takes a live page offline; only pages that finish onboarding after that wait for approval.
# Before turning it on in a deployment that has live pages, check that none is unapproved (doc/13-marketplace-essentials.md,
# WP-A). Default off (not in the list).
READINESS_REQUIRED=google,payout
# true = skip the connection checks (local development only; ignored in production) so a demo page is bookable
# without connecting Google or adding payout details.
READINESS_BYPASS=false

# Local provider mock (development only; scripts/mock-providers, started by `npm run dev:mock`). Points Google (OAuth,
# Calendar, Gmail) and Meta (Graph API, the Embedded Signup SDK) at a local mock server instead of the real services.
# Honoured only when NODE_ENV is development/test, APP_URL is localhost / 127.0.0.1 / [::1] / *.localhost, and this is
# http://127.0.0.1:<port> (or localhost / [::1]); otherwise ignored with a warning, and in production the app refuses to
# start. Leave it EMPTY here: `npm run dev:mock` sets it, with matching fake credentials, for the processes it starts.
MOCK_PROVIDERS_URL=

# Payment recovery + system health (worker). Recovery asks Razorpay about orders whose webhook never arrived (every 2 min).
PAYMENT_RECOVERY_ENABLED=true
# Who is emailed when a health condition crosses its threshold, and when it clears (comma list). Empty = webhook/log only.
# Alerts also go to ERROR_WEBHOOK_URL. Point an uptime monitor at <APP_URL>/api/health/watchdog to be alerted when the worker itself stops.
ADMIN_ALERT_EMAILS=
# Thresholds (the defaults shown). A count is unhealthy when above its limit; ages when older.
HEALTH_WORKER_STALE_SECONDS=180
HEALTH_PAYMENT_UNRECOVERED_MINUTES=10
HEALTH_MEETING_STUCK_MINUTES=15
HEALTH_QUEUE_FAILED_MAX=5
HEALTH_QUEUE_WAITING_MAX=50
HEALTH_HOLD_SWEEP_GRACE_MINUTES=5
HEALTH_RECOVERY_FAILING_RUNS=3
# The recovery loop runs every 2 minutes; alert when its last run is older than this (3x the interval).
HEALTH_RECOVERY_STALE_MINUTES=6
# The same alert is not repeated within this many minutes.
HEALTH_ALERT_DEDUPE_MINUTES=60

# Start-up validation (lib/env.ts): with NODE_ENV=production the app refuses to start on a bad configuration (APP_URL not
# https, APP_SECRET under 32 characters, no REDIS_URL or Razorpay keys, EMAIL_PROVIDER=log, MESSAGING_DRY_RUN=true,
# WHATSAPP_DISABLED=true, READINESS_BYPASS=true, RATE_LIMIT_ENABLED=false, a value with leading or trailing whitespace,
# ...). Development only prints warnings.
# true = run the production containers on your own machine (docker compose up). Honoured ONLY while APP_URL is
# http://localhost..., and it relaxes only the dev-only-setting checks above. Never set it in a real deployment.
ALLOW_INSECURE_LOCAL_RUN=false
