DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sessions
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Calendar / Meet (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorised redirect URI" on the OAuth client, e.g. http://localhost:3000/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes, base64. Encrypts influencer refresh tokens at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs connect links and OAuth state (16+ chars):  openssl rand -base64 32
APP_SECRET=

# WhatsApp / SMS messaging (Phase 4)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret used to verify the X-Hub-Signature-256 header on delivery-status callbacks.
WHATSAPP_APP_SECRET=
SMS_API_KEY=
