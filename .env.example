DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sessions
APP_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379

# Database connection pool (per process). Keep low on hosted poolers (Supabase/PgBouncer cap connections).
DATABASE_POOL_MAX=10
# Cancel any single SQL statement after this long, and fail fast when no pooled connection is free.
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Rate limiting (Phase 7). Every /api route is limited (see lib/rate-limit/policies.ts).
# Store: auto (Redis, falling back to Postgres when Redis is down) | redis | postgres | memory
RATE_LIMIT_STORE=auto
# Set to false to disable limits (load tests only). RATE_LIMIT_MULTIPLIER scales every limit (e.g. 2 = double).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MULTIPLIER=1
# The ONE header your platform sets with the real client IP: "cf-connecting-ip" behind Cloudflare, "x-real-ip"
# on Vercel. Unset = right-most X-Forwarded-For entry (appended by your proxy). Never a client-settable header.
CLIENT_IP_HEADER=

# Branding (open decision for the owner; shown in emails, pages and the OG image)
NEXT_PUBLIC_BRAND_NAME=Session Automation
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Locale for formatting money and times in emails/messages
APP_LOCALE=en-IN

# Razorpay (test keys first). Webhook URL: <APP_URL>/api/webhooks/payment
# Subscribe to: payment.captured, payment.failed, order.paid, refund.processed, refund.failed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Chosen by you; must equal the secret typed in the Razorpay dashboard webhook settings.
RAZORPAY_WEBHOOK_SECRET=
# true = refund eligible customer/host cancellations straight away; false = flag them for a manual refund.
AUTO_REFUND_ON_CANCEL=false

# Google Calendar / Meet (Phase 3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an "Authorised redirect URI" on the OAuth client, e.g. http://localhost:3000/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# 32 random bytes, base64. Encrypts influencer refresh tokens at rest:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Signs self-service links and OAuth state (16+ chars):  openssl rand -base64 32
APP_SECRET=

# WhatsApp Cloud API (Phase 4). Templates: see lib/message-templates.ts for exact names and variables.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret used to verify the X-Hub-Signature-256 header on delivery-status callbacks.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en
# true = always fail WhatsApp so the SMS fallback is used (to test the fallback).
WHATSAPP_DISABLED=false
# true = log WhatsApp/SMS instead of sending (local development without provider accounts).
MESSAGING_DRY_RUN=false

# SMS fallback: msg91 | twilio | generic
SMS_PROVIDER=msg91
# MSG91 authkey (or the Bearer key for SMS_PROVIDER=generic)
SMS_API_KEY=
# MSG91 DLT-approved flow ids, one per message type (falls back to MSG91_TEMPLATE_DEFAULT)
MSG91_TEMPLATE_DEFAULT=
MSG91_TEMPLATE_BOOKING_CONFIRMATION=
MSG91_TEMPLATE_REMINDER_24H=
MSG91_TEMPLATE_REMINDER_15M=
MSG91_TEMPLATE_RESCHEDULE=
MSG91_TEMPLATE_CANCELLATION=
# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Only for SMS_PROVIDER=generic
SMS_API_URL=

# Email: resend | postmark | log (log = print to the console; development only)
EMAIL_PROVIDER=log
EMAIL_FROM="Bookings <bookings@example.com>"
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# Error notifications: POST every reported error here (Slack/Discord-compatible "text" field). Optional.
ERROR_WEBHOOK_URL=
# Show the /design component catalogue in production builds (it is always on in development).
ENABLE_DESIGN_PAGE=false

# Payouts (admin pays influencers manually after reconciling payments)
# Days after a session ends before its money becomes payable.
PAYOUT_HOLD_DAYS=2
# Default platform fee in basis points (1000 = 10%). An admin can override it per influencer. 0 = no fee.
PLATFORM_FEE_BPS=0

# Ask influencers to allow sending customer email from their own Gmail (gmail.send is a Google restricted scope;
# set false to request Calendar only, for example before the Google app is verified).
GOOGLE_REQUEST_GMAIL_SEND=true

# WhatsApp: each influencer connects their own WhatsApp Business number (Settings > WhatsApp).
# Meta Embedded Signup (needs your Meta app to be an approved Tech Provider). Leave empty to offer manual connect only.
META_APP_ID=
META_APP_SECRET=
META_ES_CONFIG_ID=
# 6-digit PIN used to register a newly signed-up number for the Cloud API.
WHATSAPP_REGISTRATION_PIN=
# true = for testing only: use the platform number (WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID) when an influencer has not
# connected their own. Default false: without a connection the message goes by SMS.
WHATSAPP_PLATFORM_FALLBACK=false

# Go-live readiness: connections an influencer must have before their page takes bookings. Basics (verified email,
# a service, weekly hours) are always required. Comma list of: google, gmail, whatsapp, payout.
READINESS_REQUIRED=google,payout
# true = skip the connection checks (local development only; ignored in production) so a demo page is bookable
# without connecting Google or adding payout details.
READINESS_BYPASS=false

# Payment recovery + system health (worker). Recovery asks Razorpay about orders whose webhook never arrived (every 2 min).
PAYMENT_RECOVERY_ENABLED=true
# Who is emailed when a health condition crosses its threshold, and when it clears (comma list). Empty = webhook/log only.
# Alerts also go to ERROR_WEBHOOK_URL. Point an uptime monitor at <APP_URL>/api/health to be alerted when the worker itself stops.
ADMIN_ALERT_EMAILS=
# Thresholds (the defaults shown). A count is unhealthy when above its limit; ages when older.
HEALTH_WORKER_STALE_SECONDS=180
HEALTH_PAYMENT_UNRECOVERED_MINUTES=10
HEALTH_MEETING_STUCK_MINUTES=15
HEALTH_QUEUE_FAILED_MAX=5
HEALTH_QUEUE_WAITING_MAX=50
HEALTH_HOLD_SWEEP_GRACE_MINUTES=5
HEALTH_RECOVERY_FAILING_RUNS=3
# The same alert is not repeated within this many minutes.
HEALTH_ALERT_DEDUPE_MINUTES=60
