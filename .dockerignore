# Keep the build context small and, above all, keep secrets and local state out of image layers.

# Secrets and local configuration: never copied into an image (pass configuration at runtime). Patterns start with **/
# because .dockerignore (unlike .gitignore) only matches the context root without it. The last line re-includes the
# documented template.
**/.env
**/.env*
**/*.env
**/*.pem
**/*.key
!.env.example

# Dependencies and build output are produced inside the image.
node_modules
.next
generated
# The React app's build outputs: produced inside the image by `npm run build` (Vite), never copied from the host.
web/dist
public/assets
*.tsbuildinfo
next-env.d.ts

# Version control, CI, editor and agent tooling.
.git
.github
.claude
.agents
.vscode
.idea
.dockerignore
Dockerfile*
docker-compose*.yml

# The local provider mock (doc/11-provider-simulator.md) is a development tool: its code never enters an image.
scripts/mock-providers
scripts/dev-mock.ts
scripts/dev-mock-worker.ts

# The development launchers (npm run dev, dev:hmr, dev:mock): tooling for a developer's machine.
scripts/dev.ts
scripts/dev-spa.ts
scripts/dev-process.ts

# Not needed at runtime.
tests
doc
*.md
coverage
npm-debug.log*
