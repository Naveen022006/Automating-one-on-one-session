generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ServiceType {
  ONE_TO_ONE
  GROUP
}

// Lifecycle: HELD -> PENDING_PAYMENT -> PAID -> SCHEDULED -> COMPLETED
// Side exits: EXPIRED, CANCELLED, FAILED
enum BookingStatus {
  // The customer asked to book a service that needs the influencer's approval. The seat is held (for up to
  // REQUEST_TTL_HOURS) but nothing can be paid yet. Approved -> HELD (pay within the payment window); declined -> CANCELLED.
  REQUESTED
  HELD
  PENDING_PAYMENT
  PAID
  SCHEDULED
  COMPLETED
  EXPIRED
  CANCELLED
  FAILED
}

model Influencer {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  email         String    @unique
  timezone      String    @default("Asia/Kolkata")
  bio           String?
  photoUrl      String?   @map("photo_url")
  // Set when the influencer finishes the onboarding wizard (Phase 7). Null for accounts still onboarding.
  onboardedAt   DateTime? @map("onboarded_at")
  // Notification preferences for influencer alerts (failed messages, Google reconnect, refunds needed).
  notifyByEmail Boolean   @default(true) @map("notify_by_email")
  createdAt     DateTime  @default(now()) @map("created_at")

  services           Service[]
  rules              AvailabilityRule[]
  blockedDates       BlockedDate[]
  googleToken        GoogleToken?
  user               User?
  payoutAccount      PayoutAccount?
  whatsappConnection WhatsAppConnection?
  // Platform fee in basis points (1000 = 10%) taken from this influencer's payouts. Null = use the platform default
  // (PLATFORM_FEE_BPS). Decided by the administrator.
  platformFeeBps     Int?                @map("platform_fee_bps")
  payouts            Payout[]

  @@map("influencers")
}

// An influencer's login (Phase 7). Customers stay guests; only influencers have accounts. One user owns exactly
// one influencer profile. The email is stored lowercased.
model User {
  id                String    @id @default(cuid())
  email             String    @unique
  // Self-describing hash string (see lib/auth/password.ts), never the password itself.
  passwordHash      String    @map("password_hash")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  termsAcceptedAt   DateTime  @map("terms_accepted_at")
  passwordChangedAt DateTime? @map("password_changed_at")
  influencerId      String    @unique @map("influencer_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  influencer         Influencer               @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  sessions           AuthSession[]
  passwordResets     PasswordResetToken[]
  emailVerifications EmailVerificationToken[]

  @@map("users")
}

// A logged-in browser. The cookie carries a random token; only its SHA-256 is stored, so a database leak does not
// leak usable sessions.
model AuthSession {
  id              String   @id @default(cuid())
  tokenHash       String   @unique @map("token_hash")
  userId          String   @map("user_id")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  lastUsedAt      DateTime @default(now()) @map("last_used_at")
  // When the password was last entered on this session. Sensitive actions (refunds, password change, log out
  // everywhere...) require this to be within the last 8 hours, otherwise the user re-enters their password.
  authenticatedAt DateTime @default(now()) @map("authenticated_at")
  userAgent       String?  @map("user_agent")
  ip              String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

// Single-use, hashed, 1-hour password reset token.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Single-use, hashed email verification token.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// Database-backed rate limit counters (Phase 7). Used when Redis is not configured or is unreachable, so API
// rate limits keep working on the database alone. One row per (key, fixed window); expired rows are swept by the
// worker. See lib/rate-limit.
model RateLimitBucket {
  key         String
  windowStart DateTime @map("window_start")
  count       Int      @default(0)
  expiresAt   DateTime @map("expires_at")

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// A day the influencer is unavailable (holiday, leave...). Slots are never generated for a blocked day and
// holds for it are refused. The `date` is a calendar day (midnight UTC) matched against a slot's day in the
// influencer's timezone. One row per influencer per day.
model BlockedDate {
  id           String   @id @default(cuid())
  influencerId String   @map("influencer_id")
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@unique([influencerId, date])
  @@index([influencerId])
  @@map("blocked_dates")
}

enum GoogleTokenStatus {
  ACTIVE
  // Google rejected the refresh token (revoked, expired, scope removed). Meetings cannot be created
  // for this influencer until they go through the connect flow again.
  RECONNECT_NEEDED
}

// The influencer's own Google OAuth grant. Meet links must be created with it: a service account
// cannot create Meet links for personal Gmail accounts. The refresh token is stored AES-256-GCM encrypted.
model GoogleToken {
  id                String            @id @default(cuid())
  influencerId      String            @unique @map("influencer_id")
  refreshTokenEnc   String            @map("refresh_token_enc")
  scope             String
  status            GoogleTokenStatus @default(ACTIVE)
  reconnectReason   String?           @map("reconnect_reason")
  reconnectNeededAt DateTime?         @map("reconnect_needed_at")
  // The Google account the calendar belongs to (from the OpenID email claim), shown as "Connected as ...".
  googleEmail       String?           @map("google_email")
  connectedAt       DateTime          @default(now()) @map("connected_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@map("google_tokens")
}

// What a CUSTOMER gets back when they cancel their own booking. An influencer-initiated cancel always refunds in
// full. FULL: always refund. NOTICE_24H: full refund only if cancelled at least 24 hours before the session.
// NONE: no refund on customer cancellation.
enum RefundPolicy {
  FULL
  NOTICE_24H
  NONE
}

model Service {
  id               String       @id @default(cuid())
  influencerId     String       @map("influencer_id")
  title            String
  description      String?
  durationMin      Int          @map("duration_min")
  priceMinor       Int          @map("price_minor") // smallest currency unit (paise/cents)
  currency         String       @default("INR")
  type             ServiceType  @default(ONE_TO_ONE)
  capacity         Int          @default(1)
  active           Boolean      @default(true)
  refundPolicy     RefundPolicy @default(FULL) @map("refund_policy")
  // Custom questions the customer answers when booking (array of {id,label,type,required,options?}); see lib/intake.ts.
  intakeQuestions  Json?        @map("intake_questions")
  // Booking window: the earliest a customer may book (hours from now) and the furthest ahead (days).
  minNoticeHours   Int          @default(0) @map("min_notice_hours")
  maxAdvanceDays   Int          @default(60) @map("max_advance_days")
  // "What to prepare": shown on the booking page, confirmation and email.
  prepNotes        String?      @map("prep_notes")
  // When true, a booking is a request: the influencer approves or declines it before the customer can pay.
  requiresApproval Boolean      @default(false) @map("requires_approval")
  createdAt        DateTime     @default(now()) @map("created_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  sessions   Session[]

  @@index([influencerId])
  @@map("services")
}

// Weekly recurring availability. weekday is ISO: 1 = Monday ... 7 = Sunday.
// startTime / endTime are wall-clock "HH:mm" in `timezone`.
model AvailabilityRule {
  id           String @id @default(cuid())
  influencerId String @map("influencer_id")
  weekday      Int
  startTime    String @map("start_time")
  endTime      String @map("end_time")
  timezone     String

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([influencerId, weekday])
  @@map("availability_rules")
}

// One occurrence of a service at a given instant. 1:1 services have capacity 1;
// group services share one session across many bookings (Phase 6 builds on this).
model Session {
  id        String   @id @default(cuid())
  serviceId String   @map("service_id")
  startTime DateTime @map("start_time") // UTC
  endTime   DateTime @map("end_time") // UTC
  // Group sessions share ONE Calendar event: it is created once for the first paid attendee and every other
  // attendee is added to it. These session-level fields are the source of truth; each booking gets a copy of
  // event_id/meet_link for the dashboard and messaging. 1:1 sessions leave these null (the event lives per booking).
  eventId   String?  @map("event_id")
  meetLink  String?  @map("meet_link")
  createdAt DateTime @default(now()) @map("created_at")

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([serviceId, startTime])
  @@map("sessions")
}

model Booking {
  id            String        @id @default(cuid())
  sessionId     String        @map("session_id")
  status        BookingStatus @default(HELD)
  holdExpiresAt DateTime?     @map("hold_expires_at")
  customerName  String        @map("customer_name")
  customerEmail String        @map("customer_email")
  whatsappE164  String        @map("whatsapp_e164")
  whatsappOptIn Boolean       @default(false) @map("whatsapp_opt_in")
  customerTz    String?       @map("customer_tz")
  // Set by the create-meeting job. The Calendar event id is derived from the booking id, so it is
  // recoverable even if the job dies between creating the event and saving it here.
  eventId       String?       @map("event_id")
  meetLink      String?       @map("meet_link")
  // Last create-meeting failure, cleared on success. Lets the dashboard show why a paid booking has no link yet.
  lastError     String?       @map("last_error")
  // Set when the customer's personal data was erased on request (name/email/phone replaced). Payments are kept
  // for accounting.
  redactedAt    DateTime?     @map("redacted_at")
  // The customer's answers to the service's intake questions, with the question text copied in so later edits to the
  // questions never change what was asked. Array of {id,label,answer}. Erased with the rest of the customer's data.
  intakeAnswers Json?         @map("intake_answers")
  // When the influencer approved or declined a request, and the reason given to the customer on a decline.
  decidedAt     DateTime?     @map("decided_at")
  declineReason String?       @map("decline_reason")
  // The service's cancellation policy when the customer booked (Phase 7). Later policy edits never change what an
  // existing booking was sold under. Null for bookings made before this column existed (use the service's policy).
  refundPolicy  RefundPolicy? @map("refund_policy")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  session  Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  payments Payment[]
  messages Message[]

  @@index([sessionId, status])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  provider          String        @default("razorpay")
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountMinor       Int           @map("amount_minor")
  currency          String
  status            PaymentStatus @default(CREATED)
  // Set when money was captured but the booking could not be honoured (needs a manual/automatic refund).
  needsRefund       Boolean       @default(false) @map("needs_refund")
  failureReason     String?       @map("failure_reason")
  // Refund summary (Phase 7), derived from the `refunds` rows: total refunded (pending or processed, not failed),
  // the latest refund's status ("requested" while a Razorpay call is in flight or unconfirmed, then "pending" |
  // "processed" | "failed"), and when the last refund was issued. The payment becomes REFUNDED once the total
  // reaches the amount paid; partial refunds leave it CAPTURED.
  refundStatus      String?       @map("refund_status")
  refundAmountMinor Int?          @map("refund_amount_minor")
  refundedAt        DateTime?     @map("refunded_at")
  // Set by an administrator after checking the payment against Razorpay. Only reconciled payments are payable.
  reconciledAt      DateTime?     @map("reconciled_at")
  reconciledByEmail String?       @map("reconciled_by_email")
  // The payout this payment was paid out in (set when the payout is created, cleared if it is cancelled).
  payoutId          String?       @map("payout_id")
  // Missed-webhook recovery (lib/payment-recovery.ts): when the worker last asked Razorpay whether this order was
  // paid (drives the re-check cadence and the oldest-checked-first ordering), and why the last attempt to apply a
  // payment Razorpay reports as captured failed (cleared when it succeeds). Only set while status is CREATED.
  recoveryCheckedAt DateTime?     @map("recovery_checked_at")
  recoveryError     String?       @map("recovery_error")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  refunds Refund[]
  payout  Payout?  @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([payoutId])
  @@index([status, reconciledAt])
  @@index([status, recoveryCheckedAt])
  @@map("payments")
}

// One Razorpay refund against a payment (a payment can have several partial refunds). Keyed by Razorpay's refund
// id so webhooks and reconciliation upsert the same row.
model Refund {
  id               String   @id @default(cuid())
  paymentId        String   @map("payment_id")
  providerRefundId String   @unique @map("provider_refund_id")
  amountMinor      Int      @map("amount_minor")
  // "pending" | "processed" | "failed"
  status           String
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

// Delivery channels. WHATSAPP/SMS are the real customer-messaging channels (Phase 4/5); EMAIL and LOG are
// used by the best-effort recorders in lib/email.ts and the structured-log senders so every outbound
// communication lands in one table the dashboard can read.
enum MessageChannel {
  WHATSAPP
  SMS
  EMAIL
  LOG
}

// Lifecycle: PENDING -> SENT -> DELIVERED/READ (via the WhatsApp provider status webhook, Phase 4) ; FAILED
// on give-up. The Phase 6 recorders map their 'queued'/'sent'/'failed' states onto PENDING/SENT/FAILED.
enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// One outbound customer communication (confirmation, reminder, cancellation, receipt, resent link...). The
// message job tries WhatsApp first and falls back to SMS, recording the attempt here; the delivery-status
// webhook looks rows up by providerMessageId to advance status (SENT -> DELIVERED/READ). The
// (booking, template) pair is unique so a retried send records against the same row instead of duplicating.
model Message {
  id                String         @id @default(cuid())
  bookingId         String         @map("booking_id")
  channel           MessageChannel
  template          String
  status            MessageStatus  @default(PENDING)
  providerMessageId String?        @map("provider_message_id")
  error             String?
  sentAt            DateTime?      @map("sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Unique per (booking, channel, template): one row per channel for a given message type, so a WhatsApp
  // confirmation, an email confirmation and an SMS fallback coexist (the dashboard shows the latest per
  // channel) while a retried send for the SAME channel+template upserts the same row instead of duplicating.
  @@unique([bookingId, channel, template])
  @@index([bookingId])
  @@index([providerMessageId])
  @@map("messages")
}

// One row per provider event id; the unique key is what makes webhook handling idempotent.
model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String   @map("event_id")
  type       String
  receivedAt DateTime @default(now()) @map("received_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// Platform administrators. A separate account type from influencers (own login, own session cookie, own
// short-lived sessions) so the admin plane can never be reached with an influencer session. Created from the
// command line (`npm run admin:create`), never through public registration.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  // Set to lock an admin out without deleting their audit trail.
  disabledAt   DateTime? @map("disabled_at")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Two-factor sign-in (TOTP, RFC 6238). The secret is AES-256-GCM encrypted (aad `admin-totp:<id>`); it exists
  // from the start of enrollment, but 2FA only counts once `totpEnabledAt` is set by confirming a first code.
  // `totpLastStep` is the last accepted 30-second time step, so a code can never be used twice.
  totpSecretEnc String?   @map("totp_secret_enc")
  totpEnabledAt DateTime? @map("totp_enabled_at")
  totpLastStep  Int?      @map("totp_last_step")

  // Durable lockout for code guessing (login second step and the Security page), independent of the rate limiter:
  // every code attempt is counted atomically; after 10 without a success the account's authenticator codes are refused
  // until `mfaLockedUntil` (15 min, then x4 per repeat, at most 24 h). Recovery codes still work while locked.
  // A success resets all three.
  mfaFailedCount Int       @default(0) @map("mfa_failed_count")
  mfaLockLevel   Int       @default(0) @map("mfa_lock_level")
  mfaLockedUntil DateTime? @map("mfa_locked_until")

  sessions      AdminSession[]
  audits        AdminAuditLog[]
  recoveryCodes AdminRecoveryCode[]

  @@map("admin_users")
}

// Single-use recovery codes for an admin who has lost their authenticator. Only the SHA-256 of each code is stored
// (see lib/admin/totp.ts); the plain codes are shown once, at enrollment or when regenerated.
model AdminRecoveryCode {
  id        String    @id @default(cuid())
  adminId   String    @map("admin_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, codeHash])
  @@map("admin_recovery_codes")
}

// Absolute 12-hour sessions (no sliding expiry). Only the SHA-256 of the cookie token is stored.
model AdminSession {
  id            String    @id @default(cuid())
  tokenHash     String    @unique @map("token_hash")
  adminId       String    @map("admin_id")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  userAgent     String?   @map("user_agent")
  ip            String?
  // Set when this session passed a second factor at sign-in (or enrolled one). Sensitive actions require it.
  mfaVerifiedAt DateTime? @map("mfa_verified_at")

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// Append-only record of what an administrator did (viewed bank details, reconciled a payment, paid a payout...).
// The admin email is copied onto the row so the trail survives deleting the admin account.
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String?  @map("admin_id")
  adminEmail String   @map("admin_email")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  detail     Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([adminId])
  @@map("admin_audit_logs")
}

enum PayoutMethod {
  BANK
  UPI
}

// PENDING_REVIEW: new or changed details, not payable until an administrator verifies them (this stops a hijacked
// account from silently redirecting payouts). VERIFIED: payable. REJECTED: the admin found a problem; the
// influencer must correct the details.
enum PayoutAccountStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

// Where the platform administrator sends an influencer's earnings. The account number and UPI id are stored
// AES-256-GCM encrypted (aad binds each ciphertext to this influencer); only a masked form is ever shown in the
// app, and an administrator revealing the full value is written to the audit log.
model PayoutAccount {
  id                  String              @id @default(cuid())
  influencerId        String              @unique @map("influencer_id")
  method              PayoutMethod        @default(BANK)
  accountHolderName   String              @map("account_holder_name")
  bankName            String?             @map("bank_name")
  ifsc                String?
  accountNumberEnc    String?             @map("account_number_enc")
  accountNumberMasked String?             @map("account_number_masked")
  upiIdEnc            String?             @map("upi_id_enc")
  upiIdMasked         String?             @map("upi_id_masked")
  status              PayoutAccountStatus @default(PENDING_REVIEW)
  rejectionReason     String?             @map("rejection_reason")
  reviewedAt          DateTime?           @map("reviewed_at")
  reviewedByEmail     String?             @map("reviewed_by_email")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

enum PayoutStatus {
  // Created by an administrator: the payments are locked to it and the money has not been sent yet.
  PENDING
  // The administrator sent the money and recorded the bank reference (UTR).
  PAID
  // Abandoned before sending: its payments are released and become payable again.
  CANCELLED
}

// One manual transfer from the platform owner to an influencer. Amounts are a snapshot taken when the payout was
// created: gross (what customers paid) minus refunds already made, minus the platform fee, equals net (what is sent).
model Payout {
  id              String       @id @default(cuid())
  influencerId    String       @map("influencer_id")
  status          PayoutStatus @default(PENDING)
  currency        String
  grossMinor      Int          @map("gross_minor")
  refundsMinor    Int          @map("refunds_minor")
  feeBps          Int          @map("fee_bps")
  feeMinor        Int          @map("fee_minor")
  netMinor        Int          @map("net_minor")
  paymentCount    Int          @map("payment_count")
  // What it was sent to (masked), copied at creation so history stays readable if the details change later.
  destination     String
  // Bank reference / UTR the administrator recorded when sending the money.
  reference       String?
  note            String?
  createdByEmail  String       @map("created_by_email")
  paidByEmail     String?      @map("paid_by_email")
  paidAt          DateTime?    @map("paid_at")
  // Four-eyes approval: a second administrator (not `createdByEmail`) approves before the money is marked as sent.
  approvedAt      DateTime?    @map("approved_at")
  approvedByEmail String?      @map("approved_by_email")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Restrict)
  payments   Payment[]

  @@index([influencerId, createdAt])
  @@index([status])
  @@map("payouts")
}

enum WhatsAppConnectionStatus {
  ACTIVE
  // Meta rejected the access token (revoked or expired). Messages fall back to SMS until the influencer reconnects.
  ERROR
}

// The influencer's own WhatsApp Business number, used to message their customers so the messages come from them.
// Connected through Meta Embedded Signup or by entering the WhatsApp Business Account id, phone number id and a
// permanent system-user token. The token is stored AES-256-GCM encrypted (aad binds it to this influencer) and is
// never returned to the browser or shown to administrators.
model WhatsAppConnection {
  id                String                   @id @default(cuid())
  influencerId      String                   @unique @map("influencer_id")
  wabaId            String                   @map("waba_id")
  // A phone number can belong to only one influencer.
  phoneNumberId     String                   @unique @map("phone_number_id")
  displayPhone      String?                  @map("display_phone")
  verifiedName      String?                  @map("verified_name")
  tokenEnc          String                   @map("token_enc")
  // "embedded" (Meta Embedded Signup) or "manual" (ids + token entered by hand).
  source            String                   @default("manual")
  status            WhatsAppConnectionStatus @default(ACTIVE)
  lastError         String?                  @map("last_error")
  // Template name -> { status: "APPROVED" | "PENDING" | "REJECTED" | ..., language }. Kept current by the template
  // status webhook and the Refresh button.
  templates         Json?
  templatesSyncedAt DateTime?                @map("templates_synced_at")
  connectedAt       DateTime                 @default(now()) @map("connected_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)

  @@index([wabaId])
  @@map("whatsapp_connections")
}
